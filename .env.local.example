# Supabase Configuration
# Đây là FILE MẪU — không điền key thật vào đây, chỉ điền vào .env.local (đã gitignore).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SERVICE ROLE KEY — CHỈ dùng phía server (API routes), KHÔNG thêm tiền tố NEXT_PUBLIC_.
# Lấy tại: Supabase Dashboard → Settings → API → service_role secret.
# Key này bỏ qua Row Level Security, tuyệt đối không để lộ / không commit giá trị thật.
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi bí mật tự chọn (random, dài) dùng để ký session đăng nhập (cookie httpOnly).
# Tạo nhanh bằng: openssl rand -base64 32
SESSION_SECRET=

# Gemini API Configuration — dùng cho ô chat AI (điểm danh/đánh giá/quên đồ/nhật ký).
# Cần ít nhất GEMINI_API_KEY; các key _2.._6 tuỳ chọn, dùng để xoay vòng khi hết quota.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
